@page "/"
@implements IDisposable
@inject IQuoteRequestService Api
@inject NavigationManager Nav

<PageTitle>Quote requests · Northline Job Manager</PageTitle>

<div class="page-header">
    <h1>Quote requests</h1>
    <span class="muted">@(loading ? "Loading…" : $"{requests.Count} shown")</span>
</div>

<RequestFilters @bind-Filters="filters" @bind-Filters:after="UpdateUrl" />

@if (error is not null)
{
    <p class="error">Error: @error</p>
}
else if (loading && requests.Count == 0)
{
    <p class="muted">Loading…</p>
}
else
{
    <RequestTable Requests="requests" />
}

@code {
    // Filters live in the URL, e.g. /?status=New&search=sample
    [SupplyParameterFromQuery(Name = "search")] public string? Search { get; set; }
    [SupplyParameterFromQuery(Name = "status")] public string? Status { get; set; }
    [SupplyParameterFromQuery(Name = "serviceType")] public string? ServiceType { get; set; }
    [SupplyParameterFromQuery(Name = "season")] public string? Season { get; set; }

    private QuoteFilters filters = new();
    private List<QuoteRequest> requests = [];
    private bool loading = true;
    private string? error;
    private CancellationTokenSource? cts;
    private bool firstLoad = true;

    // Runs when the page opens AND every time the query string changes
    protected override Task OnParametersSetAsync()
    {
        filters = new QuoteFilters { Search = Search, Status = Status, ServiceType = ServiceType, Season = Season };
        var delay = firstLoad ? 0 : 300; // load at once the first time, debounce after that
        firstLoad = false;
        return LoadAsync(delay);
    }

    // The filters changed on screen → write them into the URL, without adding a Back-button step
    private void UpdateUrl()
    {
        var url = Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["search"] = NullIfEmpty(filters.Search),
            ["status"] = NullIfEmpty(filters.Status),
            ["serviceType"] = NullIfEmpty(filters.ServiceType),
            ["season"] = NullIfEmpty(filters.Season),
        });
        Nav.NavigateTo(url, replace: true);
    }

    private static string? NullIfEmpty(string? value) => string.IsNullOrEmpty(value) ? null : value;

    private async Task LoadAsync(int delayMs)
    {
        // Cancel the previous search, so an older answer can't overwrite a newer one
        cts?.Cancel();
        cts?.Dispose();
        cts = new CancellationTokenSource();
        var token = cts.Token;

        try
        {
            if (delayMs > 0) await Task.Delay(delayMs, token);
            loading = true;
            error = null;
            requests = await Api.GetAllAsync(filters, token);
        }
        catch (OperationCanceledException)
        {
            return; // a newer search replaced this one
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
        catch (HttpRequestException)
        {
            error = "Could not reach the server. Is the API running?";
        }

        loading = false;
    }

    public void Dispose()
    {
        cts?.Cancel();
        cts?.Dispose();
    }
}