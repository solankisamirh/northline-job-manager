@page "/dashboard"
@inject IQuoteRequestService Api

<PageTitle>Dashboard · Northline Job Manager</PageTitle>

<h1>Northline Job Manager</h1>

@if (error is not null)
{
    <p class="text-danger">Error: @error</p>
}
else if (summary is null)
{
    <p>Loading…</p>
}
else
{
    <p>Total requests: @summary.Total</p>
    <ul>
        @foreach (var s in summary.ByStatus)
        {
            <li>@s.Status: @s.Count</li>
        }
    </ul>

    <h2>New requests</h2>
    <ul>
        @foreach (var r in newRequests)
        {
            <li>@r.CustomerName – @r.ServiceType</li>
        }
    </ul>
}

@code {
    private Summary? summary;
    private List<QuoteRequest> newRequests = [];
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Start both calls, then wait for both (like Promise.all)
            var summaryTask = Api.GetSummaryAsync();
            var newTask = Api.GetAllAsync(new QuoteFilters { Status = "New" });
            await Task.WhenAll(summaryTask, newTask);

            summary = await summaryTask;
            newRequests = await newTask;
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
        catch (HttpRequestException)
        {
            error = "Could not reach the server. Is the API running?";
        }
    }
}