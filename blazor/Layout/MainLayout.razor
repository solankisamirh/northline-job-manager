@inherits LayoutComponentBase

<button type="button" class="skip-link" @onclick="SkipToMain">Skip to main content</button>

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <span class="muted">Sample data</span>
        </div>

        <article class="content px-4" tabindex="-1" @ref="mainContent">
            @Body
        </article>
    </main>
</div>

@code {
    private ElementReference mainContent;

    private async Task SkipToMain() => await mainContent.FocusAsync();
}